# Environment configuration for Genç Sosyal

# Application URL
APP_URL="https://yourdomain.com"
FRONTEND_URL="https://yourdomain.com"
CORS_ORIGIN="https://yourdomain.com"

# Server Port
PORT=3000
NODE_ENV="production"

# Installation Lifecycle
# Set this to "true" after you have configured all environment variables successfully
SETUP_COMPLETED="true"

# Database connection
# Example: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# PostgreSQL (Docker) 
POSTGRES_USER="gencsosyal"
POSTGRES_PASSWORD="CHANGE_ME_IN_PRODUCTION"
POSTGRES_DB="genc_sosyal"
DATABASE_URL="postgresql://gencsosyal:CHANGE_ME_IN_PRODUCTION@gencsosyal-postgres:5432/genc_sosyal"

# Security (MUST BE CONFIGURED IN PRODUCTION)
JWT_SECRET="CHANGE_ME_IN_PRODUCTION"
JWT_REFRESH_SECRET="CHANGE_ME_IN_PRODUCTION"
JWT_EMAIL_SECRET="CHANGE_ME_IN_PRODUCTION"
JWT_2FA_SECRET="CHANGE_ME_IN_PRODUCTION"
ENCRYPTION_KEY="CHANGE_ME_32_BYTES_IN_PRODUCTION" # 32 byte, can be generated with: openssl rand -hex 32

ACCESS_TOKEN_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_IN="7d"

# Uploads
UPLOAD_DIR="/app/uploads"

# SMTP Configuration for Emails
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Genç Sosyal <noreply@yourdomain.com>"
